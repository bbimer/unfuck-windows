{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.39/schema.json",
  "app_specific_configuration_path": "$Env:USERPROFILE/applications.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 4,
  "default_container_padding": 4,
  "border": true,
  "border_implementation": "Windows",
  "border_style": "Rounded",
  "border_width": 3,
  "border_offset": -1,
  "border_colours": {
    "single": "#89b4fa",
    "stack": "#cba6f7",
    "floating": "#f9e2af",
    "monocle": "#a6e3a1",
    "unfocused": "#313244"
  },
  "mouse_follows_focus": false,
  "transparency": true,
  "transparency_alpha": 220,
  "animation": {
    "enabled": true,
    "duration": 250,
    "fps": 120,
    "style": {
      "movement": "EaseOutBack",
      "transparency": "Linear"
    }
  },
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha",
    "accent": "Mocha"
  },
  "stackbar": {
    "height": 24,
    "mode": "Never",
    "label": "Title",
    "tabs": {
      "width": 200,
      "font_size": 16
    }
  },
  "manage_rules": [
    {
      "kind": "Exe",
      "id": "Code.exe",
      "matching_strategy": "Equals"
    }
  ],
  "floating_applications": [
    {
      "kind": "Exe",
      "id": "OneCommander.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "pwsh.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "powershell.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "wt.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "WindowsTerminal.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "CASCADIA_HOSTING_WINDOW_CLASS",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Class",
      "id": "ConsoleWindowClass",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "conhost.exe",
      "matching_strategy": "Equals"
    }
  ],
  "ignore_rules": [
    {
      "kind": "Class",
      "id": "Windows.UI.Composition.DesktopWindowContentBridge",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "DesktopWindowXamlSource",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "OneCommanderConnector.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Exe",
      "id": "toggle_taskbar.exe",
      "matching_strategy": "Equals"
    },
    {
      "kind": "Title",
      "id": "Komorebi Cheat Sheet",
      "matching_strategy": "Equals"
    },
    [
      {
        "kind": "Exe",
        "id": "chrome.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Title",
        "id": "wants to",
        "matching_strategy": "Contains"
      }
    ],
    [
      {
        "kind": "Exe",
        "id": "chrome.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Title",
        "id": "запрашивает",
        "matching_strategy": "Contains"
      }
    ],
    [
      {
        "kind": "Exe",
        "id": "chrome.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Title",
        "id": "разрешение",
        "matching_strategy": "Contains"
      }
    ],
    [
      {
        "kind": "Exe",
        "id": "chrome.exe",
        "matching_strategy": "Equals"
      },
      {
        "kind": "Title",
        "id": "cookie",
        "matching_strategy": "Contains"
      }
    ]
  ],
  "monitors": [
    {
      "workspaces": [
        {
          "name": "DEV",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "Code.exe",
              "matching_strategy": "Equals"
            }
          ],
          "workspace_rules": [
            {
              "kind": "Exe",
              "id": "Cursor.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "idea64.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "pycharm64.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "webstorm64.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Title",
              "id": "DevTools",
              "matching_strategy": "Contains"
            },
            {
              "kind": "Title",
              "id": "localhost",
              "matching_strategy": "Contains"
            },
            {
              "kind": "Title",
              "id": "127.0.0.1",
              "matching_strategy": "Contains"
            }
          ]
        },
        {
          "name": "WEB",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "chrome.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "msedge.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "brave.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "firefox.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "zen.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "FILES",
          "layout": "BSP",
          "workspace_rules": []
        },
        {
          "name": "TERM",
          "layout": "BSP",
          "workspace_rules": []
        },
        {
          "name": "CHAT",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "Telegram.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Discord.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Slack.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "WhatsApp.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Unigram.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "MEDIA",
          "layout": "BSP",
          "initial_workspace_rules": [
            {
              "kind": "Exe",
              "id": "YouTube Music.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Spotify.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "vlc.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Obsidian.exe",
              "matching_strategy": "Equals"
            },
            {
              "kind": "Exe",
              "id": "Notion.exe",
              "matching_strategy": "Equals"
            }
          ]
        },
        {
          "name": "MISC",
          "layout": "BSP",
          "workspace_rules": []
        }
      ]
    }
  ]
}
