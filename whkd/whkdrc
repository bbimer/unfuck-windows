.shell powershell

# Reload whkd configuration
alt + o                 : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "Stop-Process -Name whkd -Force -ErrorAction SilentlyContinue; Start-Sleep -Milliseconds 200; Start-Process -FilePath 'C:\Program Files\whkd\bin\whkd.exe' -WindowStyle Hidden; [System.Media.SystemSounds]::Asterisk.Play()"
alt + shift + o         : komorebic replace-configuration "$env:USERPROFILE\komorebi.json"; komorebic enforce-workspace-rules; komorebic retile

alt + i                 : komorebic toggle-shortcuts

# App shortcuts
alt + return            : Start-Process wt
alt + t                 : Start-Process wt
alt + e                 : Start-Process explorer
alt + b                 : & "$env:USERPROFILE\.config\toggle_taskbar.exe"
alt + oem_2             : Start-Process pythonw -ArgumentList "`"$env:USERPROFILE\Desktop\_customization\scripts\cheatsheet.py`""
alt + shift + oem_2     : Start-Process pythonw -ArgumentList "`"$env:USERPROFILE\Desktop\_customization\scripts\cheatsheet.py`""
win + oem_2             : Start-Process pythonw -ArgumentList "`"$env:USERPROFILE\Desktop\_customization\scripts\cheatsheet.py`""
alt + f1                : Start-Process pythonw -ArgumentList "`"$env:USERPROFILE\Desktop\_customization\scripts\cheatsheet.py`""

alt + shift + q         : komorebic close
alt + shift + m         : komorebic minimize

# Focus windows (Arrows & Vim keys)
alt + left              : komorebic focus left
alt + down              : komorebic focus down
alt + up                : komorebic focus up
alt + right             : komorebic focus right
alt + h                 : komorebic focus left
alt + j                 : komorebic focus down
alt + k                 : komorebic focus up
alt + l                 : komorebic focus right
alt + shift + oem_4     : komorebic cycle-focus previous # oem_4 is [
alt + shift + oem_6     : komorebic cycle-focus next     # oem_6 is ]

# Monitors (Cycle focus: Alt + . / , | Move window: Alt + Shift + . / ,)
alt + oem_period            : komorebic cycle-monitor next
alt + oem_comma             : komorebic cycle-monitor previous
alt + shift + oem_period    : komorebic cycle-move-to-monitor next
alt + shift + oem_comma     : komorebic cycle-move-to-monitor previous

# Move windows (Arrows & Vim keys)
alt + shift + left      : komorebic move left
alt + shift + down      : komorebic move down
alt + shift + up        : komorebic move up
alt + shift + right     : komorebic move right
alt + shift + h         : komorebic move left
alt + shift + j         : komorebic move down
alt + shift + k         : komorebic move up
alt + shift + l         : komorebic move right
alt + shift + return    : komorebic promote

# Resize
alt + oem_plus          : komorebic resize-axis horizontal increase
alt + oem_minus         : komorebic resize-axis horizontal decrease
alt + shift + oem_plus  : komorebic resize-axis vertical increase
alt + shift + oem_minus : komorebic resize-axis vertical decrease

# Manipulate windows
alt + f                 : komorebic toggle-float
alt + shift + f         : komorebic toggle-monocle
alt + m                 : komorebic manage
alt + shift + e         : komorebic enforce-workspace-rules

# Window manager options
alt + q                 : komorebic retile
alt + p                 : komorebic toggle-pause
alt + u                 : komorebic toggle-transparency
alt + shift + u         : Start-Process pythonw -ArgumentList "`"$env:USERPROFILE\Desktop\_customization\scripts\toggle_transparency.py`""

# Layouts
alt + x                 : komorebic flip-layout horizontal
alt + y                 : komorebic flip-layout vertical

# Workspaces (Alt + 1 .. 7)
alt + 1                 : komorebic focus-workspace 0
alt + 2                 : komorebic focus-workspace 1
alt + 3                 : komorebic focus-workspace 2
alt + 4                 : komorebic focus-workspace 3
alt + 5                 : komorebic focus-workspace 4
alt + 6                 : komorebic focus-workspace 5
alt + 7                 : komorebic focus-workspace 6

# Move windows across workspaces (Alt + Shift + 1..7 or Alt + Ctrl + 1..7)
alt + shift + 1         : komorebic move-to-workspace 0
alt + shift + 2         : komorebic move-to-workspace 1
alt + shift + 3         : komorebic move-to-workspace 2
alt + shift + 4         : komorebic move-to-workspace 3
alt + shift + 5         : komorebic move-to-workspace 4
alt + shift + 6         : komorebic move-to-workspace 5
alt + shift + 7         : komorebic move-to-workspace 6

alt + ctrl + 1          : komorebic move-to-workspace 0
alt + ctrl + 2          : komorebic move-to-workspace 1
alt + ctrl + 3          : komorebic move-to-workspace 2
alt + ctrl + 4          : komorebic move-to-workspace 3
alt + ctrl + 5          : komorebic move-to-workspace 4
alt + ctrl + 6          : komorebic move-to-workspace 5
alt + ctrl + 7          : komorebic move-to-workspace 6

# ==============================================================================
# YouTube Ad-Hoc Digest & Prompt Extractor
# ==============================================================================
# Alt + D: Быстрый конспект ключевых тезисов (Summary)
alt + d                 : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli digest --from-clipboard --mode summary"

# Alt + Shift + D: Жесткий критический аудит на инфоцыганство (Audit)
alt + shift + d         : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli digest --from-clipboard --mode audit"

# Alt + Ctrl + D: Скопировать путь к последнему дайджесту в буфер обмена
alt + ctrl + d          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli latest-digest"

# Alt + Ctrl + E: Показать последний дайджест в Проводнике Windows
alt + ctrl + e          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli latest-digest --reveal"

# Alt + Ctrl + O: Открыть последний дайджест в редакторе VS Code
alt + ctrl + o          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli latest-digest --open"

# Alt + Ctrl + S: Скопировать чистый промпт Executive Summary (для прикрепленного файла)
alt + ctrl + s          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli prompt summary"

# Alt + Ctrl + A: Скопировать чистый промпт жесткого аудита (для прикрепленного файла)
alt + ctrl + a          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli prompt audit"

# Alt + Ctrl + T: Скопировать чистый промпт пошагового туториала (для прикрепленного файла)
alt + ctrl + t          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli prompt tutorial"

# Alt + Ctrl + C: Скопировать мульти-промпт кросс-анализа и синтеза (для пачки из 2+ файлов)
alt + ctrl + c          : powershell -NoProfile -NonInteractive -WindowStyle Hidden -Command "cd `$env:USERPROFILE\Desktop\_Intelligence\nullspread-research-academy; python -m research_academy.cli prompt compare"

