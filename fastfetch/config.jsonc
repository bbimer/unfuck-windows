{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "C:/Users/root/.config/fastfetch/ascii.txt",
    "padding": {
      "top": 1,
      "right": 2
    }
  },
  "display": {
    "separator": "  "
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "blue",
        "at": "white",
        "host": "magenta"
      }
    },
    {
      "type": "custom",
      "format": "\u001b[90m─────────────────────────────────"
    },
    {
      "type": "os",
      "key": "󰣛 OS",
      "keyColor": "blue"
    },
    {
      "type": "kernel",
      "key": "󰒋 Kernel",
      "keyColor": "blue"
    },
    {
      "type": "host",
      "key": "󰌢 Host",
      "keyColor": "cyan"
    },
    {
      "type": "wm",
      "key": "󱂬 WM",
      "keyColor": "cyan"
    },
    {
      "type": "terminal",
      "key": "󰆍 Terminal",
      "keyColor": "green"
    },
    {
      "type": "shell",
      "key": "󰞷 Shell",
      "keyColor": "green"
    },
    {
      "type": "cpu",
      "key": "󰻠 CPU",
      "keyColor": "yellow"
    },
    {
      "type": "gpu",
      "key": "󰍛 GPU",
      "keyColor": "yellow"
    },
    {
      "type": "memory",
      "key": "󰑭 Memory",
      "keyColor": "magenta"
    },
    {
      "type": "uptime",
      "key": "󰅐 Uptime",
      "keyColor": "magenta"
    },
    {
      "type": "custom",
      "format": "\u001b[90m─────────────────────────────────"
    },
    {
      "type": "colors",
      "paddingLeft": 2,
      "symbol": "circle"
    }
  ]
}
